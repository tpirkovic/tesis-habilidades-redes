# =============================================================================
# .gitignore de la tesis: LISTA BLANCA
# Se ignora todo y solo se habilita lo que se versiona en GitHub. Un archivo o
# carpeta nueva en Tesis/ NO se sube a menos que se agregue aqui.
# Nunca se suben: data/ (encuesta Fondecyt), intermedios/ (bases a nivel de
# encuestado), respaldos, PDF con comentarios ni lecturas.
# =============================================================================

/*
!/.gitignore
!/README.md

# Articulo (su propio .gitignore excluye _salida/, tesis.tex y *_files/)
!/articulo/

# Pipeline vigente y sus salidas agregadas
!/scripts/
/scripts/*
!/scripts/pipeline_final/
!/scripts/output_final/
/scripts/output_final/intermedios/
/scripts/output_final/figuras/*
!/scripts/output_final/figuras/art_*.pdf

# Presentaciones ante la comision
!/presentaciones/
/presentaciones/*
!/presentaciones/19082026_comite_tesis/
!/presentaciones/07102026_comisi*/

# Excluidos dentro de lo habilitado
_respaldo*/
_archivo/
*.zip
*.bak
*.bundle
*.rds
*.RData
.Rhistory
.Rproj.user/
.quarto/
.vscode/
.DS_Store
Thumbs.db
tesis_comentarios_*.pdf
articulo/capitulos/*.html
_quarto_internal_scss_error.scss
